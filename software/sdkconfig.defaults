CONFIG_FREERTOS_HZ=1000
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_LWIP_MAX_SOCKETS=12

# Native IDF 6.1 external SBC + AAC-LC. No global SDK patches.
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_A2DP_ENABLE=y
CONFIG_BT_A2DP_USE_EXTERNAL_CODEC=y
CONFIG_BT_ACL_CONNECTIONS=1
CONFIG_BT_CTRL_BR_EDR_MAX_ACL_CONN=1
CONFIG_BT_A2DP_SEP_NUM_MAX=2
CONFIG_BT_A2DP_CODEC_AAC_ENABLED=y
# S31 codec 2.6.2: avoid implicit core migration by PIE assembly kernels.
CONFIG_ESP_AUDIO_CODEC_S31_USE_ASM=n

CONFIG_CHIME_BT_VENDOR_CODECS=y

# Reference LHDC V5 backend enabled; phone/music hardware validation is pending.
CONFIG_CHIME_BT_LHDC_V5=y
